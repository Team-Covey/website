{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": "worker.js",
  // Pinned so deploys work non-interactively; the login has more than one account.
  "account_id": "baf002432f05611f72b33b7b2e5028f1",
  "compatibility_date": "2025-09-27",
  "vars": {
    "STREAMLABS_EXPECTED_USERNAME": "teamcovey",
    "STREAMLABS_SCOPES": "donations.read",
    "STREAMLABS_REDIRECT_URI": "https://teamcovey.org/streamlabs/callback"
  },
  "kv_namespaces": [
    {
      "binding": "STREAMLABS_KV",
      "id": "1e40a12ee8494690a1f189228b0eb14e"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    // The team page is filled in from the EFB's roster by the Worker (worker.js).
    "binding": "ASSETS",
    "run_worker_first": ["/about/team", "/about/team/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
